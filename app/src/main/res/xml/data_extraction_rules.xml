<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer of the database and DataStore. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="step_skyscraper.db" />
        <include domain="file" path="datastore/user_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="step_skyscraper.db" />
        <include domain="file" path="datastore/user_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
