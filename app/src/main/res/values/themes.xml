<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StepSkyscraper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.StepSkyscraper.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <!-- Night Tower sits on a navy disc so its cream faces read against the cream splash background. -->
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.StepSkyscraper</item>
    </style>
    <color name="window_background">#F4F1EC</color>
    <color name="splash_icon_background">#1F2450</color>
</resources>
