# Copy to keystore.properties (git-ignored) and fill in your upload key. Never commit the real file or the .jks.
# storeFile is relative to the project root. In CI use the STEPSKY_KEYSTORE_FILE, STEPSKY_KEYSTORE_PASSWORD,
# STEPSKY_KEY_ALIAS and STEPSKY_KEY_PASSWORD environment variables instead.
storeFile=keystore/upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
